+{
+	std::vector<std::string> shaderEnv;
+	const char *env;
+
+	env = utils::secure_getenv("LIBCAMERA_TDN");
+	if (env)
+		tdnEnabled_ = atoi(env) != 0;
+
+	if (!tdnEnabled_) {
+		LOG(Debayer, Info) << "Temporal denoise disabled";
+		return 0;
+	}
+
+	/*
+	 * The strength and the two motion thresholds are tunable from the
+	 * environment because the thresholds calibrate against sensor noise,
+	 * and that has to be measured on hardware rather than derived.
+	 */
+	env = utils::secure_getenv("LIBCAMERA_TDN_ALPHA");
