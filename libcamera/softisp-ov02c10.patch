+/**
+ * \brief Allocate the pyramid and displacement textures
+ * \return 0 on success, or a negative error code otherwise
+ */
+int DebayerEGL::allocateMotionImages()
+{
+	Size size = workSize_;
+
+	for (unsigned int i = 0; i < kMotionLevels; i++) {
+		size.width = std::max(size.width / 2, 16u);
+		size.height = std::max(size.height / 2, 16u);
+		motion_[i].size = size;
+
+		std::unique_ptr<eGLImage> *images[] = {
+			&motion_[i].sceneLuma, &motion_[i].histLuma, &motion_[i].mv
+		};
+		unsigned int j = 0;
+
+		for (auto *image : images) {
+			unsigned int unit = 5 + i * 3 + j;
+
+			*image = std::make_unique<eGLImage>(GL_RGBA, size.width,
+							   size.height,
+							   size.width * 4,
+							   GL_TEXTURE0 + unit, unit);
+			egl_.createOutputTexture2D(**image);
+
+			/*
+			 * Linear on the luma levels, because halving the image
+			 * is done by letting the filter average each 2x2 block
+			 * in one fetch. Nearest on the displacement field: it
+			 * is data, and interpolating between two different
+			 * motions produces a third that matches neither.
+			 */
+			egl_.activateBindTexture(**image);
+			GLint filter = (j == 2) ? GL_NEAREST : GL_LINEAR;
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+
+			egl_.attachTextureToFBO(**image);
+			glClear(GL_COLOR_BUFFER_BIT);
+			j++;
+		}
+	}
+
+	GLenum err = glGetError();
+	if (err != GL_NO_ERROR) {
+		LOG(Debayer, Error) << "Motion texture setup failed " << err;
+		for (unsigned int i = 0; i < kMotionLevels; i++) {
+			motion_[i].sceneLuma.reset();
+			motion_[i].histLuma.reset();
+			motion_[i].mv.reset();
+		}
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+/**
+ * \brief Build the pyramids and search them for the displacement field
+ *
+ * Runs before the temporal blend, which then uses the finest level to fetch
+ * the history from where the content actually was.
+ */
+void DebayerEGL::runMotionSearch()
+{
+	eGLImage &historyRead = *historyImage_[historyIndex_];
+
+	/* Both pyramids, coarsening one level at a time. */
+	egl_.useProgram(pyramidProgramId_);
+
+	for (unsigned int i = 0; i < kMotionLevels; i++) {
+		struct {
+			eGLImage &source;
+			eGLImage &dest;
+		} steps[] = {
+			{ i ? *motion_[i - 1].sceneLuma : *sceneImage_, *motion_[i].sceneLuma },
+			{ i ? *motion_[i - 1].histLuma : historyRead, *motion_[i].histLuma },
+		};
+
+		for (auto &step : steps) {
+			egl_.activateBindTexture(step.source);
+			glUniform1i(pyramidUniformSource_,
+				    step.source.texture_unit_uniform_id_);
+			glUniform1f(pyramidUniformIsColour_, i ? 0.0f : 1.0f);
+			egl_.attachTextureToFBO(step.dest);
+			drawQuad(pyramidAttributeVertex_, pyramidAttributeTexture_,
+				 pyramidUniformProjMatrix_, pyramidUniformStrideFactor_,
+				 motion_[i].size);
+		}
+	}
+
+	/* Search, coarsest first, each level starting from the one above it. */
+	egl_.useProgram(motionProgramId_);
+	glUniform1f(motionUniformRange_, kMotionBias);
+
+	for (int i = kMotionLevels - 1; i >= 0; i--) {
+		MotionLevel &level = motion_[i];
+		bool coarsest = (i == static_cast<int>(kMotionLevels) - 1);
+		GLfloat step[] = { 1.0f / level.size.width, 1.0f / level.size.height };
+
+		egl_.activateBindTexture(*level.sceneLuma);
+		egl_.activateBindTexture(*level.histLuma);
+		glUniform1i(motionUniformCurrent_, level.sceneLuma->texture_unit_uniform_id_);
+		glUniform1i(motionUniformHistory_, level.histLuma->texture_unit_uniform_id_);
+
+		if (!coarsest) {
+			eGLImage &prior = *motion_[i + 1].mv;
+
+			egl_.activateBindTexture(prior);
+			glUniform1i(motionUniformPrior_, prior.texture_unit_uniform_id_);
+		}
+
+		glUniform2fv(motionUniformStep_, 1, step);
+		glUniform1f(motionUniformHasPrior_, coarsest ? 0.0f : 1.0f);
+		glUniform1f(motionUniformRadius_, coarsest ? 2.0f : 1.0f);
+
+		egl_.attachTextureToFBO(*level.mv);
+		drawQuad(motionAttributeVertex_, motionAttributeTexture_,
+			 motionUniformProjMatrix_, motionUniformStrideFactor_,
+			 level.size);
+	}
+}
