+/**
+ * \brief Compile and link the pyramid and motion search passes
+ * \return 0 on success, or a negative error code otherwise
+ */
+int DebayerEGL::initMotionSearch()
+{
+	std::vector<std::string> shaderEnv;
+	const char *env = utils::secure_getenv("LIBCAMERA_TDN_MOTION");
+	GLuint vs = 0, fs = 0;
+
+	/*
+	 * Off by default, because measurement says it does not pay for
+	 * itself here.
+	 *
+	 * Following the subject lets the filter keep averaging across
+	 * motion, and on a frame that is entirely moving it does: measured
+	 * against the same captured frames shifted four pixels per frame it
+	 * takes the error down by 5.6%. But over a background that is NOT
+	 * moving the true displacement is zero, every wrong vector breaks
+	 * the accumulation that the filter depends on, and the error goes UP
+	 * by 12.6%. A webcam frame is mostly background, so the trade is a
+	 * loss overall.
+	 *
+	 * The reason the gain is so small is that the blend is already
+	 * motion adaptive: where the picture moves it falls back on the
+	 * current frame by itself, so compensation is largely a substitute
+	 * for that rather than an addition to it. Against a fixed alpha
+	 * filter, which cannot fall back, the same search is worth 1.66x -
+	 * which is what made this look far more promising than it is.
+	 *
+	 * Kept, because it is the right tool for a pipeline that can trust
+	 * its vectors: given the true displacements the same filter reaches
+	 * an error a further 25% lower, so the ceiling is real and it is the
+	 * estimate, not the idea, that falls short.
+	 */
+	if (!env || atoi(env) == 0) {
+		motionEnabled_ = false;
+		LOG(Debayer, Info) << "Motion compensation disabled";
+		return 0;
+	}
+
+	egl_.pushEnv(shaderEnv, "#version 100");
+
+	auto build = [&](Span<const unsigned char> frag, GLuint &program) -> int {
+		if (egl_.compileVertexShader(vs, identity_vert, shaderEnv))
+			return -ENODEV;
+		utils::scope_exit vGuard([&] { glDeleteShader(vs); });
+
+		if (egl_.compileFragmentShader(fs, frag, shaderEnv))
+			return -ENODEV;
+		utils::scope_exit fGuard([&] { glDeleteShader(fs); });
+
+		return egl_.linkProgram(program, vs, fs) ? -ENODEV : 0;
+	};
+
+	if (build(pyramid_frag, pyramidProgramId_)) {
+		LOG(Debayer, Error) << "Pyramid pass failed to build";
+		return -ENODEV;
+	}
+
+	egl_.useProgram(pyramidProgramId_);
+	pyramidAttributeVertex_ = glGetAttribLocation(pyramidProgramId_, "vertexIn");
+	pyramidAttributeTexture_ = glGetAttribLocation(pyramidProgramId_, "textureIn");
+	pyramidUniformProjMatrix_ = glGetUniformLocation(pyramidProgramId_, "proj_matrix");
+	pyramidUniformStrideFactor_ = glGetUniformLocation(pyramidProgramId_, "stride_factor");
+	pyramidUniformSource_ = glGetUniformLocation(pyramidProgramId_, "tex_source");
+	pyramidUniformIsColour_ = glGetUniformLocation(pyramidProgramId_, "sourceIsColour");
+
+	if (build(motion_frag, motionProgramId_)) {
+		LOG(Debayer, Error) << "Motion pass failed to build";
+		return -ENODEV;
+	}
+
+	egl_.useProgram(motionProgramId_);
+	motionAttributeVertex_ = glGetAttribLocation(motionProgramId_, "vertexIn");
+	motionAttributeTexture_ = glGetAttribLocation(motionProgramId_, "textureIn");
+	motionUniformProjMatrix_ = glGetUniformLocation(motionProgramId_, "proj_matrix");
+	motionUniformStrideFactor_ = glGetUniformLocation(motionProgramId_, "stride_factor");
+	motionUniformCurrent_ = glGetUniformLocation(motionProgramId_, "tex_current");
+	motionUniformHistory_ = glGetUniformLocation(motionProgramId_, "tex_history");
+	motionUniformPrior_ = glGetUniformLocation(motionProgramId_, "tex_prior");
+	motionUniformStep_ = glGetUniformLocation(motionProgramId_, "tex_step");
+	motionUniformHasPrior_ = glGetUniformLocation(motionProgramId_, "hasPrior");
+	motionUniformRadius_ = glGetUniformLocation(motionProgramId_, "radius");
+	motionUniformRange_ = glGetUniformLocation(motionProgramId_, "mvBias");
+
+	LOG(Debayer, Info) << "Motion compensation enabled, " << kMotionLevels
+			   << " pyramid levels";
+
+	return 0;
+}
